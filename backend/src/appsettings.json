{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*",
  "CosmosDB": {
    "CosmosAccountOptions": {
      "AccountEndpoint": "https://cars-cosmos.documents.azure.com:443"
    },
    "Containers": {
      "cars": { "DatabaseId": "carsapp", "ContainerId": "cars", "PartitionKey": "/id" },
      "users": { "DatabaseId": "carsapp", "ContainerId": "users", "PartitionKey": "/id" }
    }
  }
}
